# Add these to Vercel Dashboard → Settings → Environment Variables
# NEVER commit real values to git. Copy this file to .env.local for local dev.

# Stripe — secret key (sk_test_... or sk_live_...)
STRIPE_SECRET_KEY=sk_test_your_key_here

# Stripe — publishable key, exposed to the browser (NEXT_PUBLIC_ prefix required)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key

# Stripe webhook signing secret (whsec_...)
# IMPORTANT: test mode and live mode have DIFFERENT webhooks — set up a separate
# endpoint when you switch to live, and use the live whsec_ here.
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret

# Supabase (Settings → API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

# Vercel Cron secret — set in Vercel Dashboard, used to authenticate cron requests
CRON_SECRET=your_cron_secret_here

# Admin API secret — used to authenticate /api/admin/* endpoints
# Pass as: Authorization: Bearer <ADMIN_SECRET>
ADMIN_SECRET=your_admin_secret_here

# Resend — transactional email (https://resend.com)
# Get API key from: Resend Dashboard → API Keys
# IMPORTANT: verify roomonyc.com domain in Resend first (add DNS records)
RESEND_API_KEY=re_your_api_key_here
